		{"id":"ba69e0dfcf8b818e","type":"text","text":"Поножи","x":3385,"y":2805,"width":250,"height":60,"color":"4"},
		{"id":"2c9d562350c6e211","type":"text","text":"Сапоги","x":3385,"y":2885,"width":250,"height":60,"color":"4"},
		{"id":"200e616cc58882bb","type":"text","text":"Пояс","x":3385,"y":2975,"width":250,"height":60,"color":"4"},
		{"id":"79e87bcf02de4615","type":"text","text":"Доспехи\n- Тяжелые\n- Средние\n- Легкие\n\nТип доспехов определяет возможные характеристики","x":2621,"y":2649,"width":490,"height":266,"color":"1"},
		{"id":"189bbdff7a7732f1","type":"text","text":"Шлем","x":3385,"y":2555,"width":250,"height":60,"color":"4"},
		{"id":"b14739a6d308db14","type":"text","text":"Нагрудник","x":3385,"y":2635,"width":250,"height":60,"color":"4"},
		{"id":"4c5b41b1c3d54174","type":"text","text":"Музыкальные инструменты","x":2867,"y":2293,"width":250,"height":60,"color":"2"},
		{"id":"d8c1bec26e27e1c2","type":"text","text":"Колокольчик призыва","x":2868,"y":2099,"width":250,"height":60,"color":"2"},
		{"id":"7a38f1f8808c4ca3","type":"text","text":"Скипетр (правая рука)","x":2868,"y":2196,"width":250,"height":60,"color":"2"},
		{"id":"a866426b05fcf435","type":"text","text":"Атакует с помощью призванных существ","x":3259,"y":2099,"width":250,"height":60,"color":"2"},
		{"id":"90bcfad8d50dce67","type":"text","text":"Некромантия","x":3263,"y":2196,"width":250,"height":60,"color":"2"},
		{"id":"1b6861c28beb480a","type":"text","text":"Только усиливающие умения","x":3260,"y":2293,"width":250,"height":60,"color":"2"},
		{"id":"e22efdec71d60d12","type":"text","text":"Копья/алебарды","x":2867,"y":1405,"width":250,"height":50,"color":"1"},
		{"id":"8d514494a3eb081c","type":"text","text":"Посох","x":2867,"y":1782,"width":250,"height":50},
		{"id":"79e8f5c0bfc03fc3","type":"text","text":"Гримуар","x":2867,"y":1879,"width":250,"height":50},
		{"id":"c9caa0943553102f","type":"text","text":"Сфера","x":2867,"y":1979,"width":250,"height":60},
		{"id":"9e7b936403c63a89","type":"text","text":"Двуручное мечи\n(двуручный хват)","x":3212,"y":1220,"width":250,"height":60,"color":"1"},
		{"id":"dbe276632f147e8b","type":"text","text":"Двуручное топоры\n(двуручный хват)","x":3212,"y":1310,"width":250,"height":65},
		{"id":"e8616836bca4c25c","type":"text","text":"Бонус с использованием со щитом","x":3212,"y":1397,"width":440,"height":67,"color":"1"},
		{"id":"877e0c070593367a","type":"text","text":"Используется либо совместно с быстрым оружием/либо одновременно друг с другом. Нельзя использовать  одновременно с щитом.","x":3259,"y":1787,"width":508,"height":117},
		{"id":"3f424d1b7078ca77","type":"text","text":"Возможно использовать  с любым оружием одновременно","x":3259,"y":1949,"width":347,"height":121},
		{"id":"efbd56eb64c92e2b","type":"text","text":"Возможно использовать одновременно с быстрым и тяжелым вооружением","x":3259,"y":1532,"width":347,"height":121},
		{"id":"b9b22553756137c1","type":"text","text":"Только со сферами","x":3259,"y":1687,"width":250,"height":60},
		{"id":"070bca673615712b","type":"text","text":"<center>Система экипировки","x":901,"y":1998,"width":280,"height":58,"color":"5"},
		{"id":"5489516135f0edd5","type":"text","text":"Классы оружий","x":1951,"y":1367,"width":250,"height":60},
		{"id":"c523e83a45d0b2c2","type":"text","text":"Дальнобойное","x":2411,"y":1637,"width":250,"height":60},
		{"id":"17ac87f592de583c","type":"text","text":"Мушкет","x":2866,"y":1542,"width":250,"height":50,"color":"2"},
		{"id":"af338decabf8d649","type":"text","text":"Арбалет","x":2866,"y":1617,"width":250,"height":50,"color":"2"},
		{"id":"5539a3ea09d655ef","type":"text","text":"Лук","x":2866,"y":1697,"width":250,"height":50},
		{"id":"f52d73f3bc76f5ee","type":"text","text":"Магическое","x":2411,"y":2041,"width":250,"height":60},
		{"id":"9785d6d2037fb8b3","type":"text","text":"Рапиры","x":2866,"y":942,"width":250,"height":50},
		{"id":"e30d8c0bc07c2e65","type":"text","text":"Быстрое оружие","x":2411,"y":950,"width":250,"height":60},
		{"id":"5f619b6dd65e66db","type":"text","text":"Двуручные мечи \n(одноручный хват)","x":2867,"y":1220,"width":250,"height":60,"color":"1"},
		{"id":"4893dd28f4955302","type":"text","text":"Двуручные топоры\n(одноручный хват)","x":2867,"y":1310,"width":250,"height":65},
		{"id":"74099d1c6b2d2b30","type":"text","text":"Тяжелое вооружение","x":2411,"y":1315,"width":250,"height":60},
		{"id":"67039dc4847343fd","type":"text","text":"Катана","x":2865,"y":1005,"width":249,"height":55,"color":"2"},
		{"id":"14c010e324d1107b","type":"text","text":"Парные рапиры","x":3359,"y":942,"width":250,"height":50},
		{"id":"58baa8a1377b170f","type":"text","text":"Парные катаны","x":3359,"y":1005,"width":250,"height":60,"color":"2"},
		{"id":"70963a94d0d3a20f","type":"text","text":"Нельзя использовать щит.","x":3358,"y":1084,"width":250,"height":60,"color":"2"},
		{"id":"f9d9f6a136eca0c9","type":"text","text":"Ближний бой","x":2407,"y":597,"width":250,"height":60},
		{"id":"95f6943120e7970b","type":"text","text":"Кастеты","x":2866,"y":597,"width":250,"height":60},
		{"id":"221f40845d0fa923","type":"text","text":"Щиты используются только с быстрым или тяжелым вооружением. Всегда нужна пара.","x":3485,"y":326,"width":334,"height":123},
		{"id":"cc63a52b0d3fecf9","type":"text","text":"Щиты","x":3147,"y":358,"width":250,"height":60},
		{"id":"74918452db5172ae","type":"text","text":"Защита","x":2407,"y":357,"width":250,"height":60},
		{"id":"25342b751958aa33","type":"text","text":"Концептуальный пример: \n- Использование оружия, которое занимает одну руку, совместно с другим, носит исключительно визуальный характер. \n- Пример: При экипировки меча и посоха (аки Гэндальф) + лука, персонаж активирует анимацию передвижений двух оружий, но при использовании навыков (к примеру) посоха, персонаж активирует анимацию навыка характерную для атаки только посохом. При использовании лука, он переходит в анимационную стойку лука. После при использовании навыка \"Меча\", после завершения анимации уходит в стойку меч+посох.\n","x":4840,"y":-1723,"width":580,"height":326,"color":"3"},
		{"id":"3e1e04a26e4924cb","type":"text","text":"Концепт визуальные комбинации оружий:\nПравая рука + левая рука\n\n\nПравая рука: кинжал, меч, рапира, двуручный меч, двуручный топор, копьё, скипетр\n\nЛевая рука: посох, гримуар, арбалет, щит\n\nДвуручный хват/парное оружие: парные кинжалы, парные мечи, парные рапиры, катана, парные катаны, двуручный меч, двуручный топор, кастеты\n\nСфера, представляет собой 1-2 летающих вокруг персонажа магические сферы и могут быть визуально комбинированы с любым оружием. Сферы не отображаются на спине персонажа и видны только в бою в случае экипировке в слот снаряжения.\n\n","x":4840,"y":-1409,"width":580,"height":497,"color":"3"},
		{"id":"e3adb005ed64405b","type":"text","text":"Изменение внешнего вида предмета\n- Извлечение внешки из предмета с целью вставки в слот внешнего вида\n- Извлечь внешний вид можно только из снаряжения получаемого в игре\n- Внешний вид предметов купленный в игровом магазине, возможно экипировать только в \"слоты внешнего вида\"","x":4840,"y":-912,"width":580,"height":192,"color":"3"},
		{"id":"91189fe7a4e2ea4f","type":"text","text":"Концептуальный пример открытия возможности крафтить по новому рецепту:\nЛук обычного грейда 40 уровня рецепта: Необходим 40 уровень в \"профессии\" \"производства предметов\" и условный 27 уровень \"деревообработки\". Так же уровень соответствующей мастерской. \nВ зависимости из каких ресурсов делается предмет такие требования к профессии и должны быть.\n","x":5420,"y":-1724,"width":770,"height":280,"color":"3"},
		{"id":"00505a8a3aa422b3","type":"text","text":"Концептуальный пример улучшения грейда снаряжения:\nЕсли условная броня имеет изначально на обычном уровне качества: 100 ед. защиты. \"базовой характеристики\" То при повышении качества рецепта, улучшается его \"базовый значения\", на определенный коэффициент для каждого грейда.\nТо есть работает перемножение. \nТаким образом вещь обычного грейда улучшения на +10, будет значительно хуже, той же вещи легендарного грейда. (Различие должно быть в 2х)","x":5420,"y":-1444,"width":770,"height":270,"color":"3"},
		{"id":"e8a114bd65889a0b","type":"text","text":"Концептуальный пример: \n- Используя навык меча, и если в анимации присутствует движение атаки с помощью двух рук, то перед началом анимацией из другой руки пропадает оружие. Но после окончания анимации, персонаж уходит в стойку с двумя оружиями","x":5420,"y":-1174,"width":770,"height":199,"color":"3"},
		{"id":"ce77e055d3fbe2d6","type":"text","text":"Инвентарь и экипировка\n- Экипировка служит основным источником характеристик\n- Экипировка помещается в специальные \"ячейки экипировки\" в окне снаряжения персонажа\n- Всего ячеек экипировки 15 штук\n- Три ячейки - оружие, причем каждая ячейка дает характеристики только, если она активна, активна может быть только \"одна ячейка оружия\"\n- Шесть ячеек - доспехи, где каждая ячейка перманентно дает характеристики персонажу\n- Шесть ячеек - аксессуары, где каждая ячейка перманентно дает характеристики персонажу\n- На клавишу I открываются два виджета \"Окно снаряжения\" и \"Инвентарь\"\n- На клавишу P открывается виджет \"Информация об игроке\" в котором можно увидеть суммарное значение всех характеристик персонажа полученных из различных источников\n- Каждый элемент экипировка может быть в 5 разных стадий грейда (качества) от обычного до легендарного\n- Чем выше грейд элемента экипировки, тем выше его базовые характеристики (подробнее в разделе \"Характеристики\")\n- Каждый элемент экипировки возможно улучшать от 0 (базовый уровень) до +10\n- За каждый уровень улучшения экипировки, улучшаемый предмет дает большое количество соответствующих предмету характеристик для игрового персонажа\n- Количество получаемых характеристик зависит от уровня улучшения и текущего грейда элемента экипировки (подробнее в разделе \"Характеристики\")\n- У каждой ячейки из 15 ячеек экипировки есть собственное значение \"текущей прочности\" и \"максимальной прочности\"\n","x":2859,"y":-2441,"width":770,"height":566,"color":"5"},
		{"id":"b7f0e840c8fd8e3a","type":"text","text":"Качество (грейд/тир) предметов\n1 Обычный (Common) (Темно-Серый)\n2 Необычный (Uncommon) (Темно-Зеленый)\n3 Редкий (Rare) (Сине-голубой)\n4 Эпический (Epic) (Темно-Фиолетовый)\n5 Легендарный (Legendary) (Глубокий Оранжевый)","x":2383,"y":-2167,"width":476,"height":292},
		{"id":"c20dc8b369f4c7d5","type":"text","text":"Ячейки снаряжения:\n- Со старта все ячейки заполнены базовыми предметами с минимальными характеристиками\n- Ячейки двойные, одни для экипировки, другие для внешнего вида предмета. Эффект косметический.\n\n1. Weapon One / Оружие №1\n2. Weapon Two / Оружие №2\n3. Weapon Three / Оружие №3\n4. Helmet / Шлем\n5. Chest / Доспех\n6. Gloves / Перчатки\n7. Belt / Пояс\n8. Pants / Поножи\n9. Boots / Сапоги\n10. Necklace / Ожерелье\n11. Bracelet / Браслеты\n12. Ring One / Кольцо №1\n13. Ring Two / Кольцо №2\n14. Earring One / Серьга №1\n15. Earring Two / Серьга №2\n\n","x":-2967,"y":-808,"width":476,"height":502},
		{"id":"d37910810c05efa3","type":"text","text":"Штраф к эффективности со щитом. ","x":3085,"y":500,"width":375,"height":50},
		{"id":"a8095d63dfbd98d0","type":"text","text":"Кинжалы","x":2866,"y":767,"width":250,"height":50,"color":"2"},
		{"id":"3e4cb754b5d4556d","type":"text","text":"Мечи","x":2867,"y":823,"width":250,"height":50},
		{"id":"fa75c4d47eadb8f0","type":"text","text":"Парные кинжалы","x":3359,"y":760,"width":250,"height":57,"color":"2"},
		{"id":"24abca24aa04001d","type":"text","text":"Парные мечи ","x":3360,"y":823,"width":250,"height":50},
		{"id":"c9e49a55f7fdacaf","type":"text","text":"Топоры","x":2867,"y":880,"width":250,"height":50},
		{"id":"ef6c3effa54a4309","type":"text","text":"Парные топоры","x":3360,"y":880,"width":250,"height":50},
		{"id":"daf19c523d25b81e","type":"text","text":"Прочность элементов экипировки\n*Одна из основных механик в ПК и выводу денег из игры*\nВозможно стоит откозаться от постепенной полоки, а оставить только макс прочность, как штраф при смертях. Это значительно облегчит нагрузку на сервер, так как не придется от каждой атаки высчитывать прочности всех предметов экипировки.\n\n\n- При диапазоне прочности предметов от 0-25 единиц (применяется пропорциональное снижение характеристик предмета от 100% до 0%)\n- При прочности от 25% - 100%, характеристики предмета не снижаются\n- Прочность медленно снижается при фарме. Фулл снижение прочности за 2-3 часа.\n- Обычный ремонт - достаточно дешев и возможен непосредственно на месте фарма или рядом с ним\n- Максимальная прочность предметов восстанавливается весьма дорого и только в кузнеце/в ювелирной мастерской в городе при использовании обычных спец. итемов из крафта или редкого выпадения при фарме.\n- Единица прочности 1 предмета снаряжения стоит 1 обычный спец. итем\n- Ремонт полностью сломанного предмета (от 0 максимальной прочности) сильно дороже и требует помимо обычных спец. итемок, также и специальный редкий итем на каждый полностью сломанный элемент снаряжения. С 0 прочности до 1. Далее только обычный спец. итем.\n- Прочность предмета привязана к ячейке экипировки \n- Максимальная прочность предметов в зависимости от грейда равна от 100 до 200\n1. Прочность оружия - снижается при атаке оружием\n2. Прочность брони - снижается при получении урона\n3. Прочность аксессуаров снижается в пропорции 1/2 от получения/нанесения урона\n4. Максимальная прочность снижается при смерти в разном процентом/численном отношении в зависимости от причины и условий смерти ","x":2859,"y":-1875,"width":770,"height":650,"color":"1"}
	],
